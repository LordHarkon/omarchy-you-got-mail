#!/usr/bin/env bash
# Gmail provider for You've Got Mail.
#
# Unread anywhere except spam, trash and drafts. Skip-inbox labels are
# included because they are just unread mail that is not in INBOX.
#
#   gmail list [--page TOKEN]
#   gmail preview <id>
#   gmail read <id>
#   gmail read-all
#
# gws owns the OAuth token. This script never sees a credential.

set -uo pipefail
umask 077

export GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND="${GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND:-file}"

for candidate in "$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/.bun/bin"; do
  case ":$PATH:" in
    *":$candidate:"*) ;;
    *) [ -d "$candidate" ] && PATH="$PATH:$candidate" ;;
  esac
done
export PATH

# Inbox unread, plus unread on labels you created (including skip-inbox).
# Gmail's UNREAD system label also covers trash and archived tab mail
# (Promotions/Updates with no user label) that the web UI does not show as
# unread in Inbox or the label list — that is not part of this pile.
QUERY="is:unread -in:spam -in:trash -in:drafts -in:chats (in:inbox OR has:userlabels)"

ACCOUNT_ID="${YOU_GOT_MAIL_ACCOUNT_ID:-gmail}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-you-got-mail/${ACCOUNT_ID}"
CACHE_FILE="$CACHE_DIR/messages.json"
PROFILE_FILE="$CACHE_DIR/profile.json"
LABEL_FILE="$CACHE_DIR/labels.json"
PREVIEW_FILE="$CACHE_DIR/preview.html"
PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

die() {
  printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | jq -Rs .)"
  exit 0
}

gmail_error() {
  local raw="${1:-could not read unread mail}"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  if [[ "$lower" == *invalid_grant* \
     || "$lower" == *"token has been expired or revoked"* \
     || "$lower" == *"has been expired"* \
     || "$lower" == *"authentication failed"* \
     || "$lower" == *"failed to get token"* \
     || "$lower" == *unauthenticated* \
     || "$lower" == *unauthorized* ]]; then
    die "Gmail sign-in expired. In a terminal: GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file gws auth login -s gmail"
  fi
  die "$raw"
}

write_private() {
  local dest="$1" tmp
  tmp="$(mktemp "$dest.XXXXXX" 2>/dev/null)" || return 1
  chmod 600 -- "$tmp" 2>/dev/null
  cat > "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$dest" || { rm -f -- "$tmp"; return 1; }
}

readable_file() {
  [ -f "$1" ] && [ ! -L "$1" ]
}

max_messages() {
  local value="${YOU_GOT_MAIL_MAX:-25}"
  case "$value" in
    ''|*[!0-9]*) printf '25'; return 0 ;;
  esac
  [ "${#value}" -le 3 ] || { printf '25'; return 0; }
  local n=$((10#$value))
  [ "$n" -ge 1 ] || { printf '25'; return 0; }
  [ "$n" -le 200 ] || { printf '200'; return 0; }
  printf '%s' "$n"
}

valid_id() {
  [[ "$1" =~ ^[0-9a-f]{1,32}$ ]]
}

private_dir() {
  local dir="$1" owner
  # umask 077 already makes new parents 700; -m with -p would not.
  mkdir -p -- "$dir" 2>/dev/null
  [[ -d "$dir" && ! -L "$dir" ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ "$owner" == "$(id -u)" ]] || return 1
  chmod 700 -- "$dir" 2>/dev/null || return 1
  find "$dir" -mindepth 1 -maxdepth 1 ! -type f -exec rm -rf -- {} + 2>/dev/null
  find "$dir" -mindepth 1 -maxdepth 1 -type f -exec chmod 600 -- {} + 2>/dev/null
}

command -v jq >/dev/null 2>&1 || die "jq not found on PATH"
command -v gws >/dev/null 2>&1 || die "gws not found on PATH - see the README"
private_dir "$CACHE_DIR" || die "cache directory is not usable"

gws_gmail() {
  gws gmail "$@"
}

gws_list() {
  local errfile="$CACHE_DIR/gws.err" out
  out="$(gws gmail "$@" 2>"$errfile")" || true
  if printf '%s' "$out" | jq -e 'type == "object" and .error' >/dev/null 2>&1; then
    gmail_error "$(printf '%s' "$out" | jq -r '.error.message // "could not read unread mail"')"
  fi
  if printf '%s' "$out" | jq -e 'type == "object"' >/dev/null 2>&1; then
    printf '%s' "$out"
    return 0
  fi
  local msg
  msg="$(tr -s '[:space:]' ' ' <"$errfile" 2>/dev/null)"
  [ -n "$msg" ] || msg="$(tr -s '[:space:]' ' ' <<<"$out")"
  gmail_error "${msg:-could not read unread mail}"
}

ensure_json_object() {
  local file="$1"
  readable_file "$file" && jq -e 'type == "object"' -- "$file" >/dev/null 2>&1 && return 0
  printf '{}\n' | write_private "$file"
}

account_email() {
  local cached email
  if readable_file "$PROFILE_FILE"; then
    cached="$(jq -r '.emailAddress // empty' "$PROFILE_FILE" 2>/dev/null)"
    [ -n "$cached" ] && { printf '%s' "$cached"; return 0; }
  fi
  email="$(gws_gmail users getProfile --params '{"userId":"me"}' 2>/dev/null \
    | jq -r '.emailAddress // empty' 2>/dev/null)"
  [ -n "$email" ] || return 1
  printf '{"emailAddress":%s}\n' "$(printf '%s' "$email" | jq -Rs .)" | write_private "$PROFILE_FILE"
  printf '%s' "$email"
}

search_url() {
  local email="$1"
  local q
  q="$(jq -rn --arg q "$QUERY" '$q | @uri')"
  if [[ "$email" =~ ^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then
    printf 'https://mail.google.com/mail/u/0/?authuser=%s#search/%s' \
      "$(printf '%s' "$email" | jq -Rr @uri)" "$q"
  else
    printf 'https://mail.google.com/mail/u/0/#search/%s' "$q"
  fi
}

message_url() {
  local email="$1" thread="$2"
  if [[ "$email" =~ ^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then
    printf 'https://mail.google.com/mail/u/0/?authuser=%s#all/%s' \
      "$(printf '%s' "$email" | jq -Rr @uri)" "$thread"
  else
    printf 'https://mail.google.com/mail/u/0/#all/%s' "$thread"
  fi
}

# Gmail's size estimate is a coarse bucket (often 201) and is not a
# mailbox total. When the display page already holds every match, `listed`
# is exact. Otherwise count ids with one extra list (API max 500).
unread_total() {
  local listed="$1" next="$2" token="$3" page ids
  if [ -z "$token" ] && [ -z "$next" ]; then
    printf '%s' "$listed"
    return 0
  fi
  page="$(gws_list users messages list --params "$(
    jq -nc --arg q "$QUERY" --argjson n 500 \
      '{userId:"me",q:$q,maxResults:$n}')")"
  ids="$(printf '%s' "$page" | jq '[.messages[]?.id | select(test("^[0-9a-f]{1,32}$"))] | length' 2>/dev/null)"
  case "$ids" in
    ''|*[!0-9]*) printf '%s' "$listed" ;;
    *) printf '%s' "$ids" ;;
  esac
}

fill_labels_from_cache() {
  local ids unknown fetched
  ids="$1"

  unknown="$(jq -r --slurpfile cache "$CACHE_FILE" --slurpfile map "$LABEL_FILE" '
      [ .[] | $cache[0][.].lab // [] | .[] ]
      | map(select($map[0][.] == null))
      | length
    ' <<<"$ids" 2>/dev/null)"
  case "$unknown" in ''|*[!0-9]*) return 0 ;; 0) return 0 ;; esac

  fetched="$(gws_gmail users labels list --params '{"userId":"me"}' 2>/dev/null \
    | jq -c '[.labels[]? | select(.type == "user")
              | {key: .id, value: (.name | split("/") | last)}] | from_entries' 2>/dev/null)"
  [ -n "$fetched" ] && printf '%s\n' "$fetched" | write_private "$LABEL_FILE"
}

fill_cache() {
  local ids missing tmp id
  missing="$(jq -r --slurpfile cache "$CACHE_FILE" '
      .[] | select($cache[0][.] == null)
    ' <<<"$1" 2>/dev/null)"
  [ -n "$missing" ] || return 0

  tmp="$(mktemp -d "${TMPDIR:-/tmp}/omarchy-you-got-mail.XXXXXX")" || return 0

  # Single-quoted so this shell does not expand $1/$id; xargs passes them in.
  # shellcheck disable=SC2016
  local fetch_one='
      id="$1"
      out="$2"
      params=$(jq -nc --arg id "$id" \
        "{userId:\"me\",id:\$id,format:\"metadata\",metadataHeaders:[\"Subject\",\"From\"]}")
      gws gmail users messages get --params "$params" 2>/dev/null \
        | jq -c "{(.id): {
              subject: ((.payload.headers // [] | map(select(.name == \"Subject\")) | .[0].value) // \"\"),
              from: ((.payload.headers // [] | map(select(.name == \"From\")) | .[0].value) // \"\"),
              snippet: (.snippet // \"\"),
              ts: ((.internalDate // \"0\") | tonumber? // 0),
              threadId: (.threadId // .id),
              lab: [(.labelIds // [])[] | select(startswith(\"Label_\"))]
            }}" > "$out/$id.json" 2>/dev/null
    '

  while IFS= read -r id; do
    valid_id "$id" || continue
    printf '%s\n' "$id"
  done <<<"$missing" | xargs -r -P 6 -I {} bash -c "$fetch_one" _ {} "$tmp"

  shopt -s nullglob
  local parts=("$tmp"/*.json)
  if (( ${#parts[@]} > 0 )); then
    local merged
    merged="$(jq -s '
        (.[0] // {}) as $old
        | reduce .[1:][] as $entry ($old; . + $entry)
        | to_entries
        | sort_by(-(.value.ts // 0))
        | .[0:1000]
        | from_entries
      ' "$CACHE_FILE" "${parts[@]}" 2>/dev/null)"
    [ -n "$merged" ] && printf '%s\n' "$merged" | write_private "$CACHE_FILE"
  fi
  shopt -u nullglob

  rm -rf -- "$tmp"
}

render() {
  local ids="$1" unread="$2" email="$3" next="$4" current="$5"
  local search
  search="$(search_url "$email")"

  jq -nc \
    --argjson ids "$ids" \
    --slurpfile cache "$CACHE_FILE" \
    --slurpfile labelmap "$LABEL_FILE" \
    --argjson unread "$unread" \
    --arg email "$email" \
    --arg next "$next" \
    --arg current "$current" \
    --arg search "$search" \
    --arg authuser "$email" '
    def entity:
      gsub("&lt;";"<") | gsub("&gt;";">") | gsub("&quot;";"\"")
      | gsub("&#39;";"'"'"'") | gsub("&nbsp;";" ") | gsub("&amp;";"&")
      | gsub("[\\r\\n\\t]+"; " ") | gsub(" +"; " ")
      | ltrimstr(" ") | rtrimstr(" ");

    def sender:
      . as $raw
      | (capture("^\\s*\"?(?<name>[^\"<]*?)\"?\\s*<(?<addr>[^>]+)>\\s*$") // null) as $m
      | if $m == null then ($raw | ltrimstr(" ") | rtrimstr(" "))
        elif ($m.name | length) > 0 then $m.name
        else $m.addr end;

    def mail_url($thread):
      if ($authuser | test("^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$")) then
        "https://mail.google.com/mail/u/0/?authuser=\($authuser | @uri)#all/\($thread)"
      else
        "https://mail.google.com/mail/u/0/#all/\($thread)"
      end;

    ($labelmap[0] // {}) as $names
    | def mine: [ .[] | $names[.] | select(. != null) ];

    ($cache[0] // {}) as $c
    | {
        ok: true,
        email: $email,
        unread: $unread,
        searchUrl: $search,
        nextPage: $next,
        thisPage: $current,
        messages: [
          $ids[]
          | . as $id
          | ($c[$id] // {}) as $m
          | ($m.threadId // $id) as $thread
          | {
              id: $id,
              threadId: $thread,
              subject: ((($m.subject // "") | entity) as $s
                        | if ($s | length) > 0 then $s else "(no subject)" end),
              from: (($m.from // "") | entity | sender),
              snippet: (($m.snippet // "") | entity),
              ts: (($m.ts // 0) / 1000 | floor),
              labels: (($m.lab // []) | mine),
              url: mail_url($thread)
            }
        ]
      }'
}

cmd_list() {
  local token="" max page ids next unread email listed

  while [ $# -gt 0 ]; do
    case "$1" in
      --page) shift; token="${1:-}" ;;
      --limit) shift; export YOU_GOT_MAIL_MAX="${1:-25}" ;;
    esac
    shift
  done
  case "$token" in *[!A-Za-z0-9_-]*) token="" ;; esac

  max="$(max_messages)"
  page="$(gws_list users messages list --params "$(
    jq -nc --arg q "$QUERY" --argjson n "$max" --arg t "$token" \
      '{userId:"me",q:$q,maxResults:$n} + (if $t == "" then {} else {pageToken:$t} end)')")"
  ids="$(printf '%s' "$page" | jq -c '[.messages[]?.id | select(test("^[0-9a-f]{1,32}$"))]' 2>/dev/null)"
  [ -n "$ids" ] || ids='[]'
  next="$(printf '%s' "$page" | jq -r '.nextPageToken // empty' 2>/dev/null)"
  case "$next" in *[!A-Za-z0-9_-]*) next="" ;; esac

  listed="$(printf '%s' "$ids" | jq 'length')"
  unread="$(unread_total "$listed" "$next" "$token")"
  email="$(account_email)" || email=""

  ensure_json_object "$CACHE_FILE"
  ensure_json_object "$LABEL_FILE"
  fill_cache "$ids"
  fill_labels_from_cache "$ids"
  render "$ids" "$unread" "$email" "$next" "$token"
}

cmd_read() {
  local id="${1:-}"
  valid_id "$id" || die "not a message id"
  gws_gmail users messages modify \
    --params "$(jq -nc --arg id "$id" '{userId:"me",id:$id}')" \
    --json '{"removeLabelIds":["UNREAD"]}' >/dev/null || die "could not mark as read"
  printf '{"ok":true}\n'
}

cmd_preview() {
  local id="${1:-}" payload rendered email thread url err
  valid_id "$id" || die "not a message id"

  # Gmail messages.get is read-only: unlike messages.modify below, fetching
  # format=raw does not remove the UNREAD label.
  payload="$(gws_list users messages get --params "$(
    jq -nc --arg id "$id" '{userId:"me",id:$id,format:"raw"}'
  )")"
  if ! printf '%s' "$payload" | jq -e 'type == "object" and (.raw | type == "string")' >/dev/null 2>&1; then
    err="$(printf '%s' "$payload" | jq -r '.error // .error.message // "could not load message"' 2>/dev/null)"
    gmail_error "${err:-could not load message}"
  fi

  rendered="$(printf '%s' "$payload" | python3 "$PLUGIN_ROOT/lib/gmail_preview.py" "$PREVIEW_FILE")"
  if ! printf '%s' "$rendered" | jq -e 'type == "object" and .ok == true' >/dev/null 2>&1; then
    err="$(printf '%s' "$rendered" | jq -r '.error // "could not render message"' 2>/dev/null)"
    die "${err:-could not render message}"
  fi

  email="$(account_email)" || email=""
  thread="$(printf '%s' "$payload" | jq -r '.threadId // .id // empty' 2>/dev/null)"
  valid_id "$thread" || thread="$id"
  url="$(message_url "$email" "$thread")"
  jq -nc --argjson detail "$rendered" --arg url "$url" '$detail + {url:$url}'
}

fail_read_all() {
  printf '{"ok":false,"marked":%s,"error":%s}\n' "$1" "$(printf '%s' "$2" | jq -Rs .)"
  exit 0
}

cmd_read_all() {
  local token="" page ids next all='[]' seen='|' marked=0 chunk n total i

  while :; do
    [ "${SECONDS:-0}" -gt 90 ] && fail_read_all 0 "timed out collecting unread mail"
    page="$(gws_list users messages list --params "$(
      jq -nc --arg q "$QUERY" --argjson n 500 --arg t "$token" \
        '{userId:"me",q:$q,maxResults:$n} + (if $t == "" then {} else {pageToken:$t} end)')")"
    ids="$(printf '%s' "$page" | jq -c '[.messages[]?.id | select(test("^[0-9a-f]{1,32}$"))]' 2>/dev/null)"
    [ -n "$ids" ] || ids='[]'
    all="$(jq -nc --argjson a "$all" --argjson b "$ids" \
      'reduce $b[] as $id ($a; if index($id) then . else . + [$id] end)')"
    next="$(printf '%s' "$page" | jq -r '.nextPageToken // empty' 2>/dev/null)"
    case "$next" in *[!A-Za-z0-9_-]*) next="" ;; esac
    [ -z "$next" ] && break
    case "$seen" in
      *"|$next|"*) die "gmail repeated a page token" ;;
    esac
    seen="${seen}${next}|"
    token="$next"
  done

  total="$(printf '%s' "$all" | jq 'length')"
  i=0
  while [ "$i" -lt "$total" ]; do
    [ "${SECONDS:-0}" -gt 100 ] && fail_read_all "$marked" "timed out marking mail as read"
    chunk="$(printf '%s' "$all" | jq -c --argjson i "$i" '.[$i:$i+1000]')"
    n="$(printf '%s' "$chunk" | jq 'length')"
    if ! gws_gmail users messages batchModify \
      --params '{"userId":"me"}' \
      --json "$(jq -nc --argjson ids "$chunk" '{ids:$ids,removeLabelIds:["UNREAD"]}')" \
      >/dev/null
    then
      fail_read_all "$marked" "could not mark as read"
    fi
    marked=$((marked + n))
    i=$((i + 1000))
  done
  printf '{"ok":true,"marked":%s}\n' "$marked"
}

case "${1:-list}" in
  list) shift; cmd_list "$@" ;;
  preview) cmd_preview "${2:-}" ;;
  read) cmd_read "${2:-}" ;;
  read-all) cmd_read_all ;;
  *)    die "unknown command" ;;
esac
