#!/usr/bin/env bash
# you-got-mail - data source and account CLI for the Omarchy widget.
#
# The panel calls:
#   you-got-mail list [--page OFFSET] [--limit N]
#   you-got-mail preview <id>
#   you-got-mail read <id>
#   you-got-mail read-all
#
# Accounts are added in a terminal:
#   you-got-mail accounts add
#   you-got-mail accounts login [id]
#
# Output of list/read/read-all is always one JSON object. Failures print
# {"ok":false,...} and exit 0 so the widget never crashes on empty stdout.

set -uo pipefail
umask 077

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export YOU_GOT_MAIL_ROOT="$ROOT"

for candidate in "$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/.bun/bin"; do
  case ":$PATH:" in
    *":$candidate:"*) ;;
    *) [ -d "$candidate" ] && PATH="$PATH:$candidate" ;;
  esac
done
export PATH

if ! command -v python3 >/dev/null 2>&1; then
  printf '{"ok":false,"error":"python3 is required"}\n'
  exit 0
fi

exec python3 "$ROOT/lib/cli.py" "$@"
